  "scope": "Initial read-only values of the 43 named SDK event-name properties mapped to TMapEventNames static const strings and its const map. The SDK object is writable/configurable and aliases the Vsm object; Dart values are immutable snapshots. No mutation, object identity equivalence, namespace object, listener, event dispatch or callback contract is verified.",
  "adaptation": {
    "native": "Writable/configurable JavaScript property in an aliased namespace; values may later change.",
    "dart": "Compile-time immutable Dart string and const map, containing initial pinned value.",
    "rationale": "Provides the initial named string values without claiming mutable object equivalence."
  },
  "dimensions": {
    "inputs-defaults": "Named zero-argument static property read, no user input; exact initial SDK and Dart values for all 43 names.",
